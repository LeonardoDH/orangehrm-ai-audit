{
  "name": "orangehrm-ai-audit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven OrangeHRM audit with Codex, Playwright and GitHub",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test unit/*.test.js",
    "test:e2e": "playwright test",
    "test:live": "playwright test tests/smoke.spec.js",
    "audit": "node src/cli.js explore",
    "automate": "node src/cli.js automate",
    "review": "node src/cli.js review",
    "pipeline": "node src/cli.js pipeline",
    "doctor": "node src/cli.js doctor",
    "demo": "node scripts/demo.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@openai/codex": "0.165.0",
    "@playwright/test": "1.64.1"
  }
}
